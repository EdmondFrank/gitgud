<%# The HTML shell (including <title>) is provided by the root layout `GitGud.Web.Layouts.root`. %>
<main class="hero">
  <div class="hero-body">
    <div class="container">
      <div class="box">
        <div class="is-pulled-right">
          <a href="<%= Routes.landing_page_path(@conn, :index) %>">
            <img src="<%= Routes.static_path(@conn, "/images/logo.svg") %>" alt="" width="72" height="72" />
          </a>
        </div>

        <h1 class="title has-text-grey-lighter"><%= Plug.Conn.Status.reason_phrase(@conn.status) %></h1>
        <%= @inner_content %>
      </div>
    </div>
  </div>
</main>
