<.page_header conn={assigns[:conn]} socket={assigns[:socket]} current_user={assigns[:current_user]} flash={assigns[:flash]} />

<main class="container">
  <div class="columns">
    <div class="user-profile column is-one-quarter">
      <div class="has-text-centered">
        <%= user_avatar(@user, size: 150) %>
        <h1 class="title"><%= @user.login %></h1>
        <h2 class="subtitle"><%= @user.name %></h2>
        <div class="content has-text-grey">
          <%= @user.bio %>
        </div>
      </div>

      <hr />

      <ul>
        <%= if @user.location do %>
          <li>
            <span class="icon has-text-grey">
              <i class="fa fa-map-marker"></i>
            </span>
            <%= @user.location %>
          </li>
        <% end %>
        <%= if @user.public_email do %>
          <li>
            <span class="icon has-text-grey">
              <i class="fa fa-envelope"></i>
            </span>
            <a href={"mailto:#{@user.public_email.address}"}><%= @user.public_email.address %></a>
          </li>
        <% end %>
        <%= if @user.website_url do %>
          <li>
            <span class="icon has-text-grey">
              <i class="fa fa-link"></i>
            </span>
            <a href={@user.website_url}><%= @user.website_url %></a>
          </li>
        <% end %>
      </ul>

      <hr />
      <div class="site-stats column">
        <h3 class="title is-5">Site Stats</h3>
        <ul>
          <li>
            <span class="icon has-text-grey">
              <i class="fa fa-users"></i>
            </span>
            <%= @site_stats.users %> Users registered
          </li>
          <%= if @site_stats.first_at do %>
            <li>
              <span class="icon has-text-grey">
                <i class="fa fa-clock"></i>
              </span>
              Created since <%= datetime_format(@site_stats.first_at, "{relative}") %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
    <div class="column">
      <div class="tabs">
        <ul>
          <%= navigation_item @conn, :user, :show do %>
            <a href={~p"/#{@user}"}>
              <span class="icon"><i class="fa fa-user-circle" aria-hidden="true"></i></span>
              <span>Overview</span>
            </a>
          <% end %>
          <%= navigation_item @conn, :repo, :index do %>
            <a href={~p"/#{@user}/repositories"}>
              <span class="icon"><i class="fa fa-boxes" aria-hidden="true"></i></span>
              <span>Repositories <span class="tag"><%= Enum.count(@user.repos) %></span></span>
            </a>
          <% end %>
        </ul>
      </div>

      <br />

      <%= @inner_content %>
    </div>
  </div>
</main>