<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta content="IE=edge" http-equiv="X-UA-Compatible">
    <meta content="width=device-width, initial-scale=1" name="viewport">

    <%= if verified?(@conn) do %>
      <%= tag :meta, name: "token", content: authentication_token(@conn) %>
    <% end %>

    <meta name="csrf-token" content={get_csrf_token()}>

    <title><%= title(@conn) %></title>

    <link rel="icon" href={~p"/favicon.ico"} sizes="any">
    <link rel="icon" href={~p"/images/logo.svg"}>
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"}>
    <link rel="manifest" href={~p"/manifest.webmanifest"}>
    <link phx-track-static rel="stylesheet" href={~p"/assets/index.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/index.js"}></script>
  </head>

  <body>
    <%= @inner_content %>
  </body>
</html>
