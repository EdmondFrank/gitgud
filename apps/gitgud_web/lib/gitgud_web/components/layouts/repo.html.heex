<.page_header conn={assigns[:conn]} socket={assigns[:socket]} current_user={assigns[:current_user]} flash={assigns[:flash]} />

<% {helper, action} =
     case assigns[:conn] do
       nil -> current_live_route(assigns)
       conn -> current_route(conn)
     end %>

<main class="container">
  <.repo_header repo={@repo} helper={helper} action={action} current_user={assigns[:current_user]} open_issues={assigns[:repo_open_issue_count]} revision={assigns[:revision]} />

  <%= @inner_content %>
</main>