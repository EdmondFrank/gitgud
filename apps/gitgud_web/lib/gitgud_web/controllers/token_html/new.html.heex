<h2 class="subtitle">Add a new personal access token</h2>

<%= form_for @changeset, ~p"/settings/tokens", [as: :token], fn f -> %>
  <div class="field">
    <%= label(f, :name, class: "label") %>
    <div class="control">
      <%= text_input(f, :name, class: "input", placeholder: "AiderDesk on laptop") %>
    </div>
    <%= error_tag(f, :name) %>
  </div>

  <div class="field">
    <label class="label">Scopes</label>
    <div class="control">
      <%= for scope <- @scopes do %>
        <label class="checkbox">
          <input
            type="checkbox"
            name="token[scopes][]"
            value={scope}
            checked={scope in (input_value(f, :scopes) || [])}
          />
          <%= scope %>
        </label>
        <br />
      <% end %>
    </div>
    <%= error_tag(f, :scopes) %>
  </div>

  <div class="field">
    <label class="label">Expires</label>
    <div class="control">
      <div class="select">
        <select name="token[expires_in_days]">
          <option value="">Never</option>
          <option value="30">30 days</option>
          <option value="90">90 days</option>
          <option value="365">1 year</option>
        </select>
      </div>
    </div>
  </div>

  <hr />

  <div class="field">
    <%= submit("Create access token", class: "button is-success") %>
  </div>
<% end %>
