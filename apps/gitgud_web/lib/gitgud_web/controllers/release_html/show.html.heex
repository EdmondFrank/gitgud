<table class="table tags-table is-fullwidth">
  <tbody>
    <tr>
      <td>
        <div class="title has-text-weight-bold">
          <%= @release.title %>
        </div>
        <span>
          <div>
            <%= user_avatar(@release.author, size: 18) %>
            <a href={~p"/#{@release.author.login}"} class="tag is-white user">
              <span class="tag is-light"><%= @release.author.name %></span>
            </a>
            <%= if @release.release_type == "normal" do %>
            <span class="tag is-primary">Release: <%= @release.tag_version %></span>
            <% else %>
            <span class="tag is-light">Preview Release: <%= @release.tag_version %></span>
            <% end %>
            <span class="tag is-light">
              <span class="icon">
                <i class="fas fa-link"></i>
              </span>
              <a href={~p"/#{@repo.owner_login}/#{@repo.name}/commit/#{@release.revision}"}>
                <%= String.slice(@release.revision, 0, 7) %>
              </a>
            </span>
            <span class="tag is-light">
              <text class="has-text-grey mr-1">created at:</text>
              <%= datetime_format(@release.inserted_at, "{ISOdate} {ISOtime}") %>
            </span>
            <span class="tag is-light">
              <text class="has-text-grey mr-1">last updated at:</text>
              <%= datetime_format(@release.updated_at, "{ISOdate} {ISOtime}") %>
            </span>
          </div>
          <div class="level-right">
            <div class="level-item">
              <div class="buttons is-pulled-right">
                <%= if authorized?(@conn, @repo, :admin) do %>
                <a href={ ~p"/#{@repo.owner_login}/#{@repo.name}/releases/#{@release.id}/edit" } class="button is-small">Edit</a>
                <%= form_for @conn, ~p"/#{@repo.owner_login}/#{@repo.name}/releases/#{@release.id}", [method: :delete, style: "display: inline"], fn _f -> %>
                  <%= submit "Delete", class: "button is-danger is-small", data: [confirm: "Once you delete a release, there is no going back.\nPlease be certain."] %>
                <% end %>
                <% end %>
              </div>
            </div>
          </div>
          <div class="content"><%= markdown_safe(@release.description) %></div>
          <nav class="panel">
            <p class="panel-heading">
              Attachments
            </p>
            <%= for attachment <- @release.attachments do %>
                <a class="panel-block" href={~p"/#{@repo.owner_login}/#{@repo.name}/releases/#{@release.id}/attachments/#{attachment.id}"}>
                  <span class="panel-icon">
                    <i class="fas fa-book" aria-hidden="true"></i>
                  </span>
                  <%= attachment.filename %>
                </a>
            <% end %>
          </nav>
        </span>
      </td>
    </tr>
  </tbody>
</table>
